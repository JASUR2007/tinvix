# ===================================================
# Tinvix Microservice Configuration
# ===================================================

# Telegram Bot
# 1. Получите токен у @BotFather
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_FROM_BOTFATHER

# 2. Укажите конкретные Telegram ID администраторов через запятую (узнать свой ID: @userinfobot)
# Не оставляйте пустым и не используйте "*", чтобы посторонние не могли добавлять товары!
ADMIN_IDS=123456789,987654321

# 3. URL каталога для Telegram Mini App:
# Для локального тестирования в десктопном клиенте: http://localhost
# Для мобильного клиента Telegram обязателен HTTPS (например, через Cloudflare Tunnel):
# cloudflared tunnel --url http://localhost:80
MINI_APP_URL=https://your-tunnel-url.trycloudflare.com

# 4. Режим работы бота:
# "polling" - для одиночного инстанса при локальной разработке
# "webhook" - для продакшена и запуска в нескольких репликах (2+ экземпляра)
BOT_MODE=polling
WEBHOOK_HOST=https://your-tunnel-url.trycloudflare.com
WEBHOOK_SECRET=my-webhook-secret-token

# 5. Безопасность API: секрет для защиты создания товаров (передаётся ботом в X-Admin-Secret)
ADMIN_API_KEY=tinvix_secret_admin_key_2026

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=tinvix_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# MinIO S3
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=products

# Публичный URL картинок:
# Относительный путь /storage/products обслуживается Nginx и MinIO,
# благодаря чему картинки открываются на любом телефоне, компьютере и туннеле без привязки к localhost!
MINIO_PUBLIC_URL=/storage/products
